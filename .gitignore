.DS_Store
.idea/
.vscode/
*.swp
*.swo
node_modules/
tmp/
.claude/*
!.claude/skills
!.claude/rules

# install.sh manifest — workspace-specific record of installed files
.hornero-manifest

# Eval runs — artifacts and scores are workspace-specific
evals/runs/*
!evals/runs/.gitkeep

# Chronicle proposals are workspace-local until human-committed → entries/
chronicle/proposals/*
!chronicle/proposals/.gitkeep

# Chronicle raw source artifacts often carry PII (interview transcripts,
# support tickets, dashboard screenshots). The synthesis under
# chronicle/ingestion/ is committed; the raw input is not.
chronicle/source/*
!chronicle/source/.gitkeep
!chronicle/source/README.md
